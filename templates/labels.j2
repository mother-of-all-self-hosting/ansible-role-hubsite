{% if hubsite_container_labels_traefik_enabled %}
traefik.enable=true

{% if hubsite_container_labels_traefik_docker_network %}
traefik.docker.network={{ hubsite_container_labels_traefik_docker_network }}
{% endif %}

{% set middlewares = [] %}

{% if hubsite_container_labels_traefik_middleware_basic_auth_enabled %}
{% set middlewares = middlewares + [hubsite_identifier + '-basic-auth'] %}
traefik.http.middlewares.{{ hubsite_identifier }}-basic-auth.basicauth.users={{ hubsite_container_labels_traefik_middleware_basic_auth_users }}
{% endif %}

{% if hubsite_container_labels_traefik_path_prefix != '/' %}
traefik.http.middlewares.{{ hubsite_identifier }}-slashless-redirect.redirectregex.regex=^(https?://[^/]+{{ hubsite_container_labels_traefik_path_prefix | regex_escape }})$
traefik.http.middlewares.{{ hubsite_identifier }}-slashless-redirect.redirectregex.replacement=${1}/
{% set middlewares = middlewares + [hubsite_identifier + '-slashless-redirect'] %}
{% endif %}

{% if hubsite_container_labels_traefik_path_prefix != '/' %}
traefik.http.middlewares.{{ hubsite_identifier }}-strip-prefix.stripprefix.prefixes={{ hubsite_container_labels_traefik_path_prefix }}
{% set middlewares = middlewares + [hubsite_identifier + '-strip-prefix'] %}
{% endif %}

{% if hubsite_container_labels_traefik_additional_request_headers.keys() | length > 0 %}
{% for name, value in hubsite_container_labels_traefik_additional_request_headers.items() %}
traefik.http.middlewares.{{ hubsite_identifier }}-add-request-headers.headers.customrequestheaders.{{ name }}={{ value }}
{% endfor %}
{% set middlewares = middlewares + [hubsite_identifier + '-add-request-headers'] %}
{% endif %}

{% if hubsite_container_labels_traefik_additional_response_headers.keys() | length > 0 %}
{% for name, value in hubsite_container_labels_traefik_additional_response_headers.items() %}
traefik.http.middlewares.{{ hubsite_identifier }}-add-response-headers.headers.customresponseheaders.{{ name }}={{ value }}
{% endfor %}
{% set middlewares = middlewares + [hubsite_identifier + '-add-response-headers'] %}
{% endif %}

traefik.http.routers.{{ hubsite_identifier }}.rule={{ hubsite_container_labels_traefik_rule }}
{% if hubsite_container_labels_traefik_priority | int > 0 %}
traefik.http.routers.{{ hubsite_identifier }}.priority={{ hubsite_container_labels_traefik_priority }}
{% endif %}
traefik.http.routers.{{ hubsite_identifier }}.service={{ hubsite_identifier }}
{% if middlewares | length > 0 %}
traefik.http.routers.{{ hubsite_identifier }}.middlewares={{ middlewares | join(',') }}
{% endif %}
traefik.http.routers.{{ hubsite_identifier }}.entrypoints={{ hubsite_container_labels_traefik_entrypoints }}
traefik.http.routers.{{ hubsite_identifier }}.tls={{ hubsite_container_labels_traefik_tls | to_json }}
{% if hubsite_container_labels_traefik_tls %}
traefik.http.routers.{{ hubsite_identifier }}.tls.certResolver={{ hubsite_container_labels_traefik_tls_certResolver }}
{% endif %}

traefik.http.services.{{ hubsite_identifier }}.loadbalancer.server.port={{ hubsite_container_http_port }}

{% if hubsite_container_labels_traefik_metrics_enabled %}
########################################################################
#                                                                      #
# Metrics                                                              #
#                                                                      #
########################################################################

{% set middlewares = hubsite_container_labels_traefik_metrics_middlewares %}

{% if hubsite_container_labels_traefik_metrics_middleware_basic_auth_enabled %}
traefik.http.middlewares.{{ hubsite_identifier }}-metrics-basic-auth.basicauth.users={{ hubsite_container_labels_traefik_metrics_middleware_basic_auth_users }}
{% set middlewares = middlewares + [hubsite_identifier + '-metrics-basic-auth'] %}
{% endif %}

traefik.http.middlewares.{{ hubsite_identifier }}-metrics-replace-path.replacepath.path=/metrics
{% set middlewares = middlewares + [hubsite_identifier + '-metrics-replace-path'] %}

traefik.http.routers.{{ hubsite_identifier }}-metrics.rule={{ hubsite_container_labels_traefik_metrics_rule }}

{% if hubsite_container_labels_traefik_metrics_priority | int > 0 %}
traefik.http.routers.{{ hubsite_identifier }}-metrics.priority={{ hubsite_container_labels_traefik_metrics_priority }}
{% endif %}

traefik.http.routers.{{ hubsite_identifier }}-metrics.service={{ hubsite_identifier }}-metrics

{% if middlewares | length > 0 %}
traefik.http.routers.{{ hubsite_identifier }}-metrics.middlewares={{ middlewares | join(',') }}
{% endif %}

traefik.http.routers.{{ hubsite_identifier }}-metrics.entrypoints={{ hubsite_container_labels_traefik_metrics_entrypoints }}

traefik.http.routers.{{ hubsite_identifier }}-metrics.tls={{ hubsite_container_labels_traefik_metrics_tls | to_json }}
{% if hubsite_container_labels_traefik_metrics_tls %}
traefik.http.routers.{{ hubsite_identifier }}-metrics.tls.certResolver={{ hubsite_container_labels_traefik_metrics_tls_certResolver }}
{% endif %}

traefik.http.services.{{ hubsite_identifier }}-metrics.loadbalancer.server.port={{ hubsite_container_http_port }}

########################################################################
#                                                                      #
# /Metrics                                                             #
#                                                                      #
########################################################################
{% endif %}

{% endif %}

{% for arg in hubsite_container_labels_additional_labels %}
{{ arg }}
{% endfor %}
